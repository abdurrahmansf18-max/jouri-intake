# Database
POSTGRES_DB=jouri
POSTGRES_USER=jouri
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jouri:change-me@db:5432/jouri

# Auth
USER_PASSWORD=
USER_PASSWORD_2=
TOTP_SECRET=
EDIT_LOCK_CODE=

# Text AI parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=gemma3:4b-it-qat

# Image AI generation/editing
# Leave OPENAI_API_KEY empty until you are ready to enable AI image generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium

# Shopify draft product sync
# Example SHOPIFY_STORE_URL: your-store.myshopify.com
SHOPIFY_STORE_URL=
# New Shopify Dev Dashboard apps: use Client ID + Client Secret (shpss_...)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy/custom admin tokens are still supported when available.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_VENDOR=Binbon Kids
SHOPIFY_IMAGE_LIMIT=12
# Shopify Admin webhook signing secret. Required for order -> Jouri stock sync.
SHOPIFY_WEBHOOK_SECRET=
# Optional: override automatic Shopify standard category mapping.
# Format: Product Type=gid://shopify/TaxonomyCategory/...
SHOPIFY_CATEGORY_MAP=
