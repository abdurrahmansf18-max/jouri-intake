# Database
POSTGRES_DB=jouri
POSTGRES_USER=jouri
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://jouri:change-me@db:5432/jouri

# Auth
USER_PASSWORD=
USER_PASSWORD_2=
TOTP_SECRET=
EDIT_LOCK_CODE=

# Text AI parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=gemma3:4b-it-qat

# Image AI generation/editing
# Leave OPENAI_API_KEY empty until you are ready to enable AI image generation.
OPENAI_API_KEY=
